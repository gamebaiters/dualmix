<ui:FluentWindow x:Class="DualMix.UI.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:core="clr-namespace:DualMix.Core"
                 xmlns:pages="clr-namespace:DualMix.UI.Pages"
                 Title="DualMix"
                 Width="1040" Height="740" MinWidth="820" MinHeight="560"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 Icon="pack://application:,,,/Assets/dualmix.ico">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="TitleBar" Grid.Row="0" Title="DualMix">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/dualmix.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <ui:NavigationView x:Name="Nav" Grid.Row="1"
                           PaneDisplayMode="Left"
                           IsBackButtonVisible="Collapsed"
                           IsPaneToggleVisible="True"
                           OpenPaneLength="232">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="{Binding [Nav.Mixer], Source={x:Static core:Loc.Instance}}" TargetPageType="{x:Type pages:MixerPage}"
                                       ToolTip="{Binding [Nav.Mixer.Tip], Source={x:Static core:Loc.Instance}}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Options24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="{Binding [Nav.Apps], Source={x:Static core:Loc.Instance}}" TargetPageType="{x:Type pages:AppsPage}"
                                       ToolTip="{Binding [Nav.Apps.Tip], Source={x:Static core:Loc.Instance}}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Apps24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="{Binding [Nav.Knob], Source={x:Static core:Loc.Instance}}" TargetPageType="{x:Type pages:KnobPage}"
                                       ToolTip="{Binding [Nav.Knob.Tip], Source={x:Static core:Loc.Instance}}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Keyboard24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="{Binding [Nav.Audio], Source={x:Static core:Loc.Instance}}" TargetPageType="{x:Type pages:AudioPage}"
                                       ToolTip="{Binding [Nav.Audio.Tip], Source={x:Static core:Loc.Instance}}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Speaker224" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.MenuItems>
            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem Content="{Binding [Nav.General], Source={x:Static core:Loc.Instance}}" TargetPageType="{x:Type pages:GeneralPage}"
                                       ToolTip="{Binding [Nav.General.Tip], Source={x:Static core:Loc.Instance}}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Settings24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.FooterMenuItems>
        </ui:NavigationView>
    </Grid>
</ui:FluentWindow>
