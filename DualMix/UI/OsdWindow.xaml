<Window x:Class="DualMix.UI.OsdWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="DualMix OSD"
        Width="328" Height="108"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Topmost="True" Focusable="False"
        IsHitTestVisible="False">
    <!-- Windows 11 flyout look: layered surface, 8 px radius, soft shadow, one glanceable value. -->
    <Border x:Name="Card" Margin="16" CornerRadius="8" BorderThickness="1" Padding="16,12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.28" Direction="270" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:SymbolIcon x:Name="OsdIcon" Grid.RowSpan="2" Symbol="Options24" FontSize="22" VerticalAlignment="Center" Margin="0,0,14,0" />
            <TextBlock x:Name="TitleText" Grid.Column="1" FontSize="12" VerticalAlignment="Bottom" />
            <TextBlock x:Name="ValueText" Grid.Column="2" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Bottom" />

            <!-- Bar: bipolar (mix) or unipolar (levels) -->
            <Grid x:Name="BarArea" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Height="14" Margin="0,8,0,0">
                <Border x:Name="Track" Height="4" CornerRadius="2" VerticalAlignment="Center" />
                <Border x:Name="Fill" Height="4" CornerRadius="2" VerticalAlignment="Center" HorizontalAlignment="Left" />
                <Rectangle x:Name="CenterMark" Width="2" Height="12" RadiusX="1" RadiusY="1" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Canvas x:Name="ThumbCanvas">
                    <Ellipse x:Name="Thumb" Width="12" Height="12" />
                </Canvas>
            </Grid>
        </Grid>
    </Border>
</Window>
