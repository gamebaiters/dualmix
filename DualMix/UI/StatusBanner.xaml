<UserControl x:Class="DualMix.UI.StatusBanner"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:core="clr-namespace:DualMix.Core"
             Focusable="False">
    <!-- Fluent "InfoBar" pattern: severity icon, title, message, one primary action. Only shown when something needs attention. -->
    <Border x:Name="Root" CornerRadius="8" BorderThickness="1" Padding="16,12" Margin="0,0,0,16"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Visibility="Collapsed"
            AutomationProperties.LiveSetting="Polite">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:SymbolIcon x:Name="Icon" Grid.Column="0" Symbol="Info24" Filled="True" FontSize="20" VerticalAlignment="Top" Margin="0,1,12,0" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <TextBlock x:Name="MessageText" FontSize="13" TextWrapping="Wrap" Margin="0,2,0,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                <ui:ProgressRing x:Name="Busy" IsIndeterminate="True" Width="20" Height="20" Margin="0,0,8,0" Visibility="Collapsed" />
                <ui:Button x:Name="RepairButton" Content="{Binding [Banner.Repair], Source={x:Static core:Loc.Instance}}" Appearance="Primary" Click="Repair_Click" Visibility="Collapsed"
                           ToolTip="{Binding [Banner.Repair.Tip], Source={x:Static core:Loc.Instance}}">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="Wrench24" />
                    </ui:Button.Icon>
                </ui:Button>
                <ui:Button x:Name="InstallButton" Content="{Binding [Banner.InstallDriver], Source={x:Static core:Loc.Instance}}" Appearance="Primary" Click="Install_Click" Visibility="Collapsed" Margin="8,0,0,0"
                           ToolTip="{Binding [Banner.InstallDriver.Tip], Source={x:Static core:Loc.Instance}}">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="ArrowDownload24" />
                    </ui:Button.Icon>
                </ui:Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
