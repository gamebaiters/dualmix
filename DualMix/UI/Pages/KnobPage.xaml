<Page x:Class="DualMix.UI.Pages.KnobPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:core="clr-namespace:DualMix.Core"
      Title="{Binding [Knob.Title], Source={x:Static core:Loc.Instance}}"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <!-- Scrolling is provided by the navigation frame (WPF-UI DynamicScrollViewer). -->
    <StackPanel Margin="{StaticResource PagePadding}" MaxWidth="1000">
        <ui:TextBlock Text="{Binding [Knob.Title], Source={x:Static core:Loc.Instance}}" FontTypography="Title" />
        <TextBlock Style="{StaticResource CaptionText}" FontSize="14" Margin="0,4,0,20"
                   Text="{Binding [Knob.Subtitle], Source={x:Static core:Loc.Instance}}" />

        <!-- Current function (hero) -->
        <Border Style="{StaticResource Surface}" Padding="24,20">
            <StackPanel>
                <TextBlock Text="{Binding [Knob.ControlCard], Source={x:Static core:Loc.Instance}}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <Border Style="{StaticResource SegmentHost}" Margin="0,12,0,0">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="TMix" Style="{StaticResource SegmentItem}" Content="{Binding [Target.Mix], Source={x:Static core:Loc.Instance}}" MinWidth="120" Checked="Target_Checked" Tag="Mix" />
                        <RadioButton x:Name="TVolume" Style="{StaticResource SegmentItem}" Content="{Binding [Target.Volume], Source={x:Static core:Loc.Instance}}" MinWidth="120" Checked="Target_Checked" Tag="Volume" />
                        <RadioButton x:Name="TGame" Style="{StaticResource SegmentItem}" Content="{Binding [Target.Game], Source={x:Static core:Loc.Instance}}" MinWidth="110" Checked="Target_Checked" Tag="Game" />
                        <RadioButton x:Name="TChat" Style="{StaticResource SegmentItem}" Content="{Binding [Target.Chat], Source={x:Static core:Loc.Instance}}" MinWidth="110" Checked="Target_Checked" Tag="Chat" />
                    </StackPanel>
                </Border>
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{Binding [Knob.TurnLeft], Source={x:Static core:Loc.Instance}}" Style="{StaticResource CaptionText}" Margin="0,0,16,4" />
                    <TextBlock x:Name="LeftText" Grid.Column="1" Style="{StaticResource BodyText}" Margin="0,0,0,4" />
                    <TextBlock Grid.Row="1" Text="{Binding [Knob.TurnRight], Source={x:Static core:Loc.Instance}}" Style="{StaticResource CaptionText}" Margin="0,0,16,4" />
                    <TextBlock x:Name="RightText" Grid.Row="1" Grid.Column="1" Style="{StaticResource BodyText}" Margin="0,0,0,4" />
                    <TextBlock Grid.Row="2" Text="{Binding [Knob.Press], Source={x:Static core:Loc.Instance}}" Style="{StaticResource CaptionText}" Margin="0,0,16,0" />
                    <TextBlock x:Name="PressText" Grid.Row="2" Grid.Column="1" Style="{StaticResource BodyText}" />
                </Grid>
                <TextBlock x:Name="FunctionNote" Style="{StaticResource CaptionText}" Margin="0,12,0,0" />
            </StackPanel>
        </Border>

        <TextBlock Text="{Binding [Knob.CycleHeader], Source={x:Static core:Loc.Instance}}" Style="{StaticResource SectionHeader}" />

        <ui:CardControl Margin="0,0,0,4">
            <ui:CardControl.Icon>
                <ui:SymbolIcon Symbol="ArrowSync24" />
            </ui:CardControl.Icon>
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Text="{Binding [Knob.DoublePress], Source={x:Static core:Loc.Instance}}" Style="{StaticResource BodyText}" />
                    <TextBlock Text="{Binding [Knob.DoublePressDesc], Source={x:Static core:Loc.Instance}}" Style="{StaticResource CaptionText}" />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:ToggleSwitch x:Name="DoublePress" Checked="Option_Changed" Unchecked="Option_Changed"
                             AutomationProperties.Name="Double-press knob to switch function" />
        </ui:CardControl>

        <ui:CardControl Margin="0,0,0,4">
            <ui:CardControl.Icon>
                <ui:SymbolIcon Symbol="KeyboardShift24" />
            </ui:CardControl.Icon>
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Text="{Binding [Knob.CtrlPress], Source={x:Static core:Loc.Instance}}" Style="{StaticResource BodyText}" />
                    <TextBlock Text="{Binding [Knob.CtrlPressDesc], Source={x:Static core:Loc.Instance}}" Style="{StaticResource CaptionText}" />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:ToggleSwitch x:Name="CtrlPress" Checked="Option_Changed" Unchecked="Option_Changed"
                             AutomationProperties.Name="Ctrl plus knob press to switch function" />
        </ui:CardControl>

        <ui:CardControl Margin="0,0,0,4">
            <ui:CardControl.Icon>
                <ui:SymbolIcon Symbol="Keyboard24" />
            </ui:CardControl.Icon>
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Text="{Binding [Knob.Hotkey], Source={x:Static core:Loc.Instance}}" Style="{StaticResource BodyText}" />
                    <TextBlock Text="{Binding [Knob.HotkeyDesc], Source={x:Static core:Loc.Instance}}" Style="{StaticResource CaptionText}" />
                </StackPanel>
            </ui:CardControl.Header>
            <StackPanel Orientation="Horizontal">
                <ui:Button x:Name="HotkeyButton" MinWidth="170" Click="Hotkey_Click" ToolTip="{Binding [Knob.HotkeyTip], Source={x:Static core:Loc.Instance}}" />
                <ui:Button Appearance="Transparent" Margin="4,0,0,0" Click="HotkeyReset_Click" ToolTip="{Binding [Knob.HotkeyResetTip], Source={x:Static core:Loc.Instance}}" Width="36" Height="36" Padding="0"
                           AutomationProperties.Name="Reset default shortcut">
                    <ui:SymbolIcon Symbol="ArrowReset24" FontSize="16" />
                </ui:Button>
            </StackPanel>
        </ui:CardControl>

        <ui:CardExpander Margin="0,0,0,4" IsExpanded="False">
            <ui:CardExpander.Icon>
                <ui:SymbolIcon Symbol="Options24" />
            </ui:CardExpander.Icon>
            <ui:CardExpander.Header>
                <StackPanel>
                    <TextBlock Text="{Binding [Knob.CycleFunctions], Source={x:Static core:Loc.Instance}}" Style="{StaticResource BodyText}" />
                    <TextBlock x:Name="CycleSummary" Style="{StaticResource CaptionText}" />
                </StackPanel>
            </ui:CardExpander.Header>
            <WrapPanel Margin="44,0,0,0">
                <CheckBox x:Name="CMix" Content="{Binding [Target.Mix], Source={x:Static core:Loc.Instance}}" Margin="0,0,24,0" Checked="Cycle_Changed" Unchecked="Cycle_Changed" />
                <CheckBox x:Name="CVolume" Content="{Binding [Target.Volume], Source={x:Static core:Loc.Instance}}" Margin="0,0,24,0" Checked="Cycle_Changed" Unchecked="Cycle_Changed" />
                <CheckBox x:Name="CGame" Content="{Binding [Target.Game], Source={x:Static core:Loc.Instance}}" Margin="0,0,24,0" Checked="Cycle_Changed" Unchecked="Cycle_Changed" />
                <CheckBox x:Name="CChat" Content="{Binding [Target.Chat], Source={x:Static core:Loc.Instance}}" Checked="Cycle_Changed" Unchecked="Cycle_Changed" />
            </WrapPanel>
        </ui:CardExpander>

        <TextBlock Text="{Binding [Knob.BehaviorHeader], Source={x:Static core:Loc.Instance}}" Style="{StaticResource SectionHeader}" />

        <ui:CardControl Margin="0,0,0,4">
            <ui:CardControl.Icon>
                <ui:SymbolIcon Symbol="Rocket24" />
            </ui:CardControl.Icon>
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Text="{Binding [Knob.StartFunc], Source={x:Static core:Loc.Instance}}" Style="{StaticResource BodyText}" />
                    <TextBlock Text="{Binding [Knob.StartFuncDesc], Source={x:Static core:Loc.Instance}}" Style="{StaticResource CaptionText}" />
                </StackPanel>
            </ui:CardControl.Header>
            <ComboBox x:Name="StartFunction" MinWidth="190" SelectionChanged="StartFunction_Changed"
                      AutomationProperties.Name="Knob function at startup">
                <ComboBoxItem Content="{Binding [Target.Volume], Source={x:Static core:Loc.Instance}}" Tag="Volume" />
                <ComboBoxItem Content="{Binding [Target.Mix], Source={x:Static core:Loc.Instance}}" Tag="Mix" />
                <ComboBoxItem Content="{Binding [Target.Game], Source={x:Static core:Loc.Instance}}" Tag="Game" />
                <ComboBoxItem Content="{Binding [Target.Chat], Source={x:Static core:Loc.Instance}}" Tag="Chat" />
                <ComboBoxItem Content="{Binding [Knob.StartLast], Source={x:Static core:Loc.Instance}}" Tag="Last" />
            </ComboBox>
        </ui:CardControl>

        <ui:CardControl Margin="0,0,0,4">
            <ui:CardControl.Icon>
                <ui:SymbolIcon Symbol="SpeakerMute24" />
            </ui:CardControl.Icon>
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Text="{Binding [Knob.MixPressMutes], Source={x:Static core:Loc.Instance}}" Style="{StaticResource BodyText}" />
                    <TextBlock Text="{Binding [Knob.MixPressMutesDesc], Source={x:Static core:Loc.Instance}}" Style="{StaticResource CaptionText}" />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:ToggleSwitch x:Name="MixPressMutes" Checked="Option_Changed" Unchecked="Option_Changed"
                             AutomationProperties.Name="On Mix mode pressing knob mutes all" />
        </ui:CardControl>

        <ui:CardControl Margin="0,0,0,4">
            <ui:CardControl.Icon>
                <ui:SymbolIcon Symbol="Power24" />
            </ui:CardControl.Icon>
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Text="{Binding [Knob.Enabled], Source={x:Static core:Loc.Instance}}" Style="{StaticResource BodyText}" />
                    <TextBlock Text="{Binding [Knob.EnabledDesc], Source={x:Static core:Loc.Instance}}" Style="{StaticResource CaptionText}" />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:ToggleSwitch x:Name="Enabled" Checked="Option_Changed" Unchecked="Option_Changed"
                             AutomationProperties.Name="DualMix handles knob" />
        </ui:CardControl>

        <ui:CardControl Margin="0,0,0,4">
            <ui:CardControl.Icon>
                <ui:SymbolIcon Symbol="ArrowSwap24" />
            </ui:CardControl.Icon>
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Text="{Binding [Knob.CtrlAlt], Source={x:Static core:Loc.Instance}}" Style="{StaticResource BodyText}" />
                    <TextBlock Text="{Binding [Knob.CtrlAltDesc], Source={x:Static core:Loc.Instance}}" Style="{StaticResource CaptionText}" />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:ToggleSwitch x:Name="CtrlAlt" Checked="Option_Changed" Unchecked="Option_Changed"
                             AutomationProperties.Name="Ctrl plus turn uses alternate function" />
        </ui:CardControl>

        <ui:CardControl Margin="0,0,0,4">
            <ui:CardControl.Icon>
                <ui:SymbolIcon Symbol="Gauge24" />
            </ui:CardControl.Icon>
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Text="{Binding [Knob.Step], Source={x:Static core:Loc.Instance}}" Style="{StaticResource BodyText}" />
                    <TextBlock Text="{Binding [Knob.StepDesc], Source={x:Static core:Loc.Instance}}" Style="{StaticResource CaptionText}" />
                </StackPanel>
            </ui:CardControl.Header>
            <StackPanel Orientation="Horizontal">
                <Slider x:Name="Step" Width="180" Minimum="1" Maximum="10" SmallChange="1" LargeChange="1" IsSnapToTickEnabled="True" TickFrequency="1"
                        ValueChanged="Step_Changed" AutomationProperties.Name="Step per detent" />
                <TextBlock x:Name="StepText" Width="44" TextAlignment="Right" VerticalAlignment="Center" Style="{StaticResource BodyText}" />
            </StackPanel>
        </ui:CardControl>

        <ui:CardControl Margin="0,0,0,4">
            <ui:CardControl.Icon>
                <ui:SymbolIcon Symbol="ArrowUndo24" />
            </ui:CardControl.Icon>
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Text="{Binding [Knob.Invert], Source={x:Static core:Loc.Instance}}" Style="{StaticResource BodyText}" />
                    <TextBlock Text="{Binding [Knob.InvertDesc], Source={x:Static core:Loc.Instance}}" Style="{StaticResource CaptionText}" />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:ToggleSwitch x:Name="Invert" Checked="Option_Changed" Unchecked="Option_Changed"
                             AutomationProperties.Name="Invert direction" />
        </ui:CardControl>

        <ui:CardExpander Margin="0,0,0,4">
            <ui:CardExpander.Icon>
                <ui:SymbolIcon Symbol="Keyboard12324" />
            </ui:CardExpander.Icon>
            <ui:CardExpander.Header>
                <StackPanel>
                    <TextBlock Text="{Binding [Knob.DedicatedKeys], Source={x:Static core:Loc.Instance}}" Style="{StaticResource BodyText}" />
                    <TextBlock Text="{Binding [Knob.DedicatedKeysDesc], Source={x:Static core:Loc.Instance}}" Style="{StaticResource CaptionText}" />
                </StackPanel>
            </ui:CardExpander.Header>
            <Grid Margin="44,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="{Binding [Knob.MoveGame], Source={x:Static core:Loc.Instance}}" Style="{StaticResource BodyText}" VerticalAlignment="Center" />
                <ui:Button x:Name="KeyGame" Grid.Column="1" MinWidth="150" Margin="0,0,0,8" Click="KeyAssign_Click" Tag="Game" />
                <TextBlock Grid.Row="1" Text="{Binding [Knob.MoveChat], Source={x:Static core:Loc.Instance}}" Style="{StaticResource BodyText}" VerticalAlignment="Center" />
                <ui:Button x:Name="KeyChat" Grid.Row="1" Grid.Column="1" MinWidth="150" Margin="0,0,0,8" Click="KeyAssign_Click" Tag="Chat" />
                <TextBlock Grid.Row="2" Text="{Binding [Knob.MixCenter], Source={x:Static core:Loc.Instance}}" Style="{StaticResource BodyText}" VerticalAlignment="Center" />
                <ui:Button x:Name="KeyReset" Grid.Row="2" Grid.Column="1" MinWidth="150" Click="KeyAssign_Click" Tag="Reset" />
            </Grid>
        </ui:CardExpander>

        <TextBlock Text="{Binding [Knob.TestHeader], Source={x:Static core:Loc.Instance}}" Style="{StaticResource SectionHeader}" />
        <Border Style="{StaticResource Surface}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ui:SymbolIcon Symbol="Pulse24" FontSize="20" VerticalAlignment="Top" Margin="0,2,0,0" />
                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                    <TextBlock x:Name="TestText" Text="{Binding [Knob.TestDefault], Source={x:Static core:Loc.Instance}}" Style="{StaticResource BodyText}" />
                    <TextBlock x:Name="KeyboardStatusText" Style="{StaticResource CaptionText}" Margin="0,4,0,0" />
                </StackPanel>
            </Grid>
        </Border>
    </StackPanel>
</Page>
