<Page x:Class="DualMix.UI.Pages.MixerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:core="clr-namespace:DualMix.Core"
      xmlns:local="clr-namespace:DualMix.UI"
      Title="{Binding [Mixer.Title], Source={x:Static core:Loc.Instance}}"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <!-- Scrolling is provided by the navigation frame (WPF-UI DynamicScrollViewer). -->
        <StackPanel Margin="{StaticResource PagePadding}" MaxWidth="1000">

            <!-- Page header -->
            <Grid Margin="0,0,0,20">
                <StackPanel>
                    <ui:TextBlock Text="{Binding [Mixer.Title], Source={x:Static core:Loc.Instance}}" FontTypography="Title" />
                    <TextBlock Style="{StaticResource CaptionText}" FontSize="14" Margin="0,4,0,0"
                               Text="{Binding [Mixer.Subtitle], Source={x:Static core:Loc.Instance}}" />
                </StackPanel>
                <Border HorizontalAlignment="Right" VerticalAlignment="Top" CornerRadius="12" Padding="10,4"
                        Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1"
                        ToolTip="{Binding [Mixer.EngineTip], Source={x:Static core:Loc.Instance}}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="EngineDot" Style="{StaticResource StatusDot}" Margin="0,0,8,0" />
                        <TextBlock x:Name="EngineChip" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>

            <local:StatusBanner />

            <!-- ChatMix -->
            <Border Style="{StaticResource Surface}" Padding="24,20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <TextBlock Text="ChatMix" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="{Binding MixText}" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="13"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,20,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="140" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Style="{StaticResource IconBadge}" Background="{DynamicResource GameSoftBrush}">
                                <ui:SymbolIcon Symbol="Games24" FontSize="20" Foreground="{DynamicResource GameBrush}" />
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Game" Style="{StaticResource CaptionText}" />
                                <TextBlock Text="{Binding GameLevelText}" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            </StackPanel>
                        </StackPanel>

                        <Slider x:Name="MixSlider" Grid.Column="1" Style="{StaticResource BalanceSlider}" Margin="16,0"
                                Value="{Binding MixPercent, Mode=TwoWay}"
                                AutomationProperties.Name="Game Chat Balance"
                                ToolTip="{Binding [Mixer.MixTip], Source={x:Static core:Loc.Instance}}"
                                MouseDoubleClick="MixSlider_DoubleClick" />

                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
                                <TextBlock Text="Chat" Style="{StaticResource CaptionText}" HorizontalAlignment="Right" />
                                <TextBlock Text="{Binding ChatLevelText}" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Right" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            </StackPanel>
                            <Border Style="{StaticResource IconBadge}" Background="{DynamicResource ChatSoftBrush}">
                                <ui:SymbolIcon Symbol="Chat24" FontSize="20" Foreground="{DynamicResource ChatBrush}" />
                            </Border>
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                        <ui:Button Content="{Binding [Mixer.AllGame], Source={x:Static core:Loc.Instance}}" Click="AllGame_Click" Margin="0,0,8,0" ToolTip="{Binding [Mixer.AllGameTip], Source={x:Static core:Loc.Instance}}" />
                        <ui:Button Content="{Binding [Mixer.Balanced], Source={x:Static core:Loc.Instance}}" Click="Center_Click" Appearance="Secondary" Margin="0,0,8,0" ToolTip="{Binding [Mixer.BalancedTip], Source={x:Static core:Loc.Instance}}" />
                        <ui:Button Content="{Binding [Mixer.AllChat], Source={x:Static core:Loc.Instance}}" Click="AllChat_Click" ToolTip="{Binding [Mixer.AllChatTip], Source={x:Static core:Loc.Instance}}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Channels -->
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Surface}">
                    <StackPanel>
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource IconBadge}" Width="32" Height="32" CornerRadius="16" Background="{DynamicResource GameSoftBrush}">
                                    <ui:SymbolIcon Symbol="Games24" FontSize="16" Foreground="{DynamicResource GameBrush}" />
                                </Border>
                                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Game" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <TextBlock Text="{Binding [Mixer.GameSub], Source={x:Static core:Loc.Instance}}" Style="{StaticResource CaptionText}" />
                                </StackPanel>
                            </StackPanel>
                            <ToggleButton Style="{StaticResource IconToggle}" HorizontalAlignment="Right" IsChecked="{Binding GameMuted, Mode=TwoWay}"
                                          AutomationProperties.Name="Mute Game" ToolTip="{Binding [Mixer.MuteGameTip], Source={x:Static core:Loc.Instance}}">
                                <ui:SymbolIcon x:Name="GameMuteIcon" Symbol="Speaker224" FontSize="18" />
                            </ToggleButton>
                        </Grid>
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="48" />
                            </Grid.ColumnDefinitions>
                            <Slider Minimum="0" Maximum="100" SmallChange="1" LargeChange="10" IsMoveToPointEnabled="True"
                                    Value="{Binding GameVolumePercent, Mode=TwoWay}" AutomationProperties.Name="Volume Game" />
                            <TextBlock Grid.Column="1" Text="{Binding GameVolumePercent, StringFormat={}{0:0}%}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                       FontSize="14" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </Grid>
                        <Border Style="{StaticResource MeterTrack}" Margin="0,12,0,0">
                            <Border x:Name="GameMeter" Background="{DynamicResource GameBrush}" HorizontalAlignment="Stretch" RenderTransformOrigin="0,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="GameMeterScale" ScaleX="0" />
                                </Border.RenderTransform>
                            </Border>
                        </Border>
                        <TextBlock x:Name="GameDevice" Style="{StaticResource CaptionText}" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Surface}">
                    <StackPanel>
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource IconBadge}" Width="32" Height="32" CornerRadius="16" Background="{DynamicResource ChatSoftBrush}">
                                    <ui:SymbolIcon Symbol="Chat24" FontSize="16" Foreground="{DynamicResource ChatBrush}" />
                                </Border>
                                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Chat" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <TextBlock Text="{Binding [Mixer.ChatSub], Source={x:Static core:Loc.Instance}}" Style="{StaticResource CaptionText}" />
                                </StackPanel>
                            </StackPanel>
                            <ToggleButton Style="{StaticResource IconToggle}" HorizontalAlignment="Right" IsChecked="{Binding ChatMuted, Mode=TwoWay}"
                                          AutomationProperties.Name="Mute Chat" ToolTip="{Binding [Mixer.MuteChatTip], Source={x:Static core:Loc.Instance}}">
                                <ui:SymbolIcon x:Name="ChatMuteIcon" Symbol="Speaker224" FontSize="18" />
                            </ToggleButton>
                        </Grid>
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="48" />
                            </Grid.ColumnDefinitions>
                            <Slider Minimum="0" Maximum="100" SmallChange="1" LargeChange="10" IsMoveToPointEnabled="True"
                                    Value="{Binding ChatVolumePercent, Mode=TwoWay}" AutomationProperties.Name="Volume Chat" />
                            <TextBlock Grid.Column="1" Text="{Binding ChatVolumePercent, StringFormat={}{0:0}%}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                       FontSize="14" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </Grid>
                        <Border Style="{StaticResource MeterTrack}" Margin="0,12,0,0">
                            <Border x:Name="ChatMeter" Background="{DynamicResource ChatBrush}" HorizontalAlignment="Stretch" RenderTransformOrigin="0,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="ChatMeterScale" ScaleX="0" />
                                </Border.RenderTransform>
                            </Border>
                        </Border>
                        <TextBlock x:Name="ChatDevice" Style="{StaticResource CaptionText}" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Output -->
            <TextBlock Text="{Binding [Mixer.OutputHeader], Source={x:Static core:Loc.Instance}}" Style="{StaticResource SectionHeader}" />
            <Border Style="{StaticResource Surface}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="280" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource IconBadge}" Width="32" Height="32" CornerRadius="16" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                        <ui:SymbolIcon Symbol="Headphones24" FontSize="16" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,16,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding OutputName}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock x:Name="FormatLine" Style="{StaticResource CaptionText}" />
                        <Border Style="{StaticResource MeterTrack}" Margin="0,8,0,0" Height="3">
                            <Border Background="{DynamicResource AccentFillColorDefaultBrush}" HorizontalAlignment="Stretch" RenderTransformOrigin="0,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="OutMeterScale" ScaleX="0" />
                                </Border.RenderTransform>
                            </Border>
                        </Border>
                    </StackPanel>
                    <Grid Grid.Column="2" VerticalAlignment="Center" IsEnabled="{Binding OutputVolumeAvailable}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="44" />
                        </Grid.ColumnDefinitions>
                        <ToggleButton Style="{StaticResource IconToggle}" IsChecked="{Binding OutputMuted, Mode=TwoWay}"
                                      AutomationProperties.Name="Mute output" ToolTip="{Binding [Mixer.MuteOutputTip], Source={x:Static core:Loc.Instance}}">
                            <ui:SymbolIcon x:Name="OutMuteIcon" Symbol="Speaker224" FontSize="18" />
                        </ToggleButton>
                        <Slider Grid.Column="1" Minimum="0" Maximum="100" SmallChange="1" LargeChange="10" IsMoveToPointEnabled="True" Margin="8,0,0,0"
                                Value="{Binding OutputVolumePercent, Mode=TwoWay}" AutomationProperties.Name="Master volume"
                                ToolTip="{Binding [Mixer.MasterVolumeTip], Source={x:Static core:Loc.Instance}}" />
                        <TextBlock Grid.Column="2" Text="{Binding OutputVolumePercent, StringFormat={}{0:0}%}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   FontSize="14" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </Grid>
                </Grid>
            </Border>

            <!-- Knob hint -->
            <Border Style="{StaticResource Surface}" Margin="0,12,0,0" Padding="20,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon Symbol="Keyboard24" FontSize="18" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Margin="12,0" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="13"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                        <Run Text="{Binding [Mixer.KnobPrefix], Source={x:Static core:Loc.Instance}, Mode=OneWay}" />
                        <Run Text="{Binding KnobTargetText, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <Run Text="{Binding [Mixer.KnobHintMid], Source={x:Static core:Loc.Instance}, Mode=OneWay}" />
                        <Run Text="{Binding KnobHotkeyText, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </TextBlock>
                    <ui:Button Grid.Column="2" Content="{Binding [Mixer.KnobSettings], Source={x:Static core:Loc.Instance}}" Appearance="Transparent" Click="KnobSettings_Click" />
                </Grid>
            </Border>
        </StackPanel>
</Page>
