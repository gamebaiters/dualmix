<Page x:Class="DualMix.UI.Pages.AudioPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:local="clr-namespace:DualMix.UI"
      Title="Audio e dispositivi"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <!-- Scrolling is provided by the navigation frame (WPF-UI DynamicScrollViewer). -->
        <StackPanel Margin="{StaticResource PagePadding}" MaxWidth="1000">
            <ui:TextBlock Text="Audio e dispositivi" FontTypography="Title" />
            <TextBlock Style="{StaticResource CaptionText}" FontSize="14" Margin="0,4,0,20"
                       Text="Le app suonano su due uscite virtuali, «DualMix Game» e «DualMix Chat». DualMix le mixa e le manda alla scheda audio reale senza perdita di qualità." />

            <local:StatusBanner ShowSuccess="True" />

            <TextBlock Text="Uscita" Style="{StaticResource SectionHeader}" Margin="0,8,0,8" />
            <ui:CardControl Margin="0,0,0,4">
                <ui:CardControl.Icon>
                    <ui:SymbolIcon Symbol="Headphones24" />
                </ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="Scheda audio reale" Style="{StaticResource BodyText}" />
                        <TextBlock Text="Dove ascolti tutto. Con «Automatico» DualMix usa sempre la Sound Blaster AE-5 (cuffie/altoparlanti)." Style="{StaticResource CaptionText}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ComboBox x:Name="OutputCombo" MinWidth="300" MaxWidth="380" DisplayMemberPath="Label" SelectionChanged="Output_Changed"
                          AutomationProperties.Name="Scheda audio reale" />
            </ui:CardControl>

            <TextBlock Text="Uscite virtuali" Style="{StaticResource SectionHeader}" />
            <ui:CardControl Margin="0,0,0,4">
                <ui:CardControl.Icon>
                    <ui:SymbolIcon Symbol="SoundSource24" />
                </ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="Usa le uscite DualMix Game e DualMix Chat" Style="{StaticResource BodyText}" />
                        <TextBlock Text="Consigliato. Se disattivato DualMix regola solo il volume delle singole app nel mixer di Windows." Style="{StaticResource CaptionText}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="UseVirtual" Checked="UseVirtual_Changed" Unchecked="UseVirtual_Changed"
                                 AutomationProperties.Name="Usa le uscite virtuali" />
            </ui:CardControl>

            <ui:CardControl Margin="0,0,0,4">
                <ui:CardControl.Icon>
                    <ui:SymbolIcon Symbol="ArrowDownload24" />
                </ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="Driver dei cavi virtuali (VB-Audio)" Style="{StaticResource BodyText}" />
                        <TextBlock x:Name="DriverText" Style="{StaticResource CaptionText}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:Button x:Name="DriverButton" Content="Installa" Click="Driver_Click" MinWidth="120" />
            </ui:CardControl>
            <ui:InfoBar x:Name="SetupInfo" IsOpen="False" IsClosable="True" Margin="0,0,0,4" />

            <ui:CardControl x:Name="GameDirectCard" Margin="0,0,0,4">
                <ui:CardControl.Icon>
                    <ui:SymbolIcon Symbol="Games24" />
                </ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="Game diretto sulla scheda audio" Style="{StaticResource BodyText}" />
                        <TextBlock Text="I giochi saltano «DualMix Game» e suonano direttamente sulla scheda: latenza zero. Il bilanciamento agisce sul volume delle singole app." Style="{StaticResource CaptionText}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="GameDirect" Checked="Option_Changed" Unchecked="Option_Changed"
                                 AutomationProperties.Name="Game diretto sulla scheda audio" />
            </ui:CardControl>

            <ui:CardControl Margin="0,0,0,4">
                <ui:CardControl.Icon>
                    <ui:SymbolIcon Symbol="Star24" />
                </ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="Imposta i dispositivi predefiniti di Windows" Style="{StaticResource BodyText}" />
                        <TextBlock x:Name="DefaultsText" Style="{StaticResource CaptionText}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="SetDefaults" Checked="Option_Changed" Unchecked="Option_Changed"
                                 AutomationProperties.Name="Imposta i dispositivi predefiniti di Windows" />
            </ui:CardControl>

            <ui:CardControl Margin="0,0,0,4">
                <ui:CardControl.Icon>
                    <ui:SymbolIcon Symbol="Apps24" />
                </ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="Indirizza le app automaticamente" Style="{StaticResource BodyText}" />
                        <TextBlock Text="Ogni app viene mandata all'uscita del suo canale. In Discord e TeamSpeak lascia l'uscita su «Predefinito»." Style="{StaticResource CaptionText}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="RouteApps" Checked="Option_Changed" Unchecked="Option_Changed"
                                 AutomationProperties.Name="Indirizza le app automaticamente" />
            </ui:CardControl>

            <TextBlock Text="Qualità" Style="{StaticResource SectionHeader}" />
            <ui:CardControl Margin="0,0,0,4">
                <ui:CardControl.Icon>
                    <ui:SymbolIcon Symbol="Gauge24" />
                </ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="Latenza" Style="{StaticResource BodyText}" />
                        <TextBlock Text="«Minima» per i giochi competitivi; «Sicura» se senti crepitii con il PC molto carico. La qualità non cambia." Style="{StaticResource CaptionText}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <Border Style="{StaticResource SegmentHost}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="LMin" Style="{StaticResource SegmentItem}" Content="Minima" Tag="Minima" Checked="Latency_Checked" />
                        <RadioButton x:Name="LBal" Style="{StaticResource SegmentItem}" Content="Bilanciata" Tag="Bilanciata" Checked="Latency_Checked" />
                        <RadioButton x:Name="LSafe" Style="{StaticResource SegmentItem}" Content="Sicura" Tag="Sicura" Checked="Latency_Checked" />
                    </StackPanel>
                </Border>
            </ui:CardControl>

            <ui:CardExpander Margin="0,0,0,4" IsExpanded="True">
                <ui:CardExpander.Icon>
                    <ui:SymbolIcon Symbol="Options24" />
                </ui:CardExpander.Icon>
                <ui:CardExpander.Header>
                    <StackPanel>
                        <TextBlock Text="Percorso del segnale" Style="{StaticResource BodyText}" />
                        <TextBlock x:Name="QualitySummary" Style="{StaticResource CaptionText}" />
                    </StackPanel>
                </ui:CardExpander.Header>
                <StackPanel Margin="44,0,0,0">
                    <TextBlock Style="{StaticResource BodyText}" FontSize="13" Margin="0,0,0,8"
                               Text="• Le uscite virtuali usano la stessa frequenza della scheda reale e «DualMix Game» anche gli stessi canali (5.1/7.1): nessuna conversione di formato, il surround resta surround." />
                    <TextBlock Style="{StaticResource BodyText}" FontSize="13" Margin="0,0,0,8"
                               Text="• DualMix cattura il mix interno di Windows a 32 bit in virgola mobile, prima di qualsiasi riduzione di bit, e lo consegna alla scheda nello stesso formato." />
                    <TextBlock Style="{StaticResource BodyText}" FontSize="13" Margin="0,0,0,8"
                               Text="• Al 100% il segnale passa identico (×1,0). Nessun limitatore, compressore o equalizzatore." />
                    <TextBlock Style="{StaticResource BodyText}" FontSize="13" Margin="0,0,0,8"
                               Text="• La minuscola differenza di clock tra i dispositivi (pochi milionesimi) è compensata da un ricampionatore sinc a 160 punti. Misurato su questo PC dalla diagnostica: livello 0,0000 dB, rumore e distorsione oltre 130 dB sotto il segnale." />
                    <TextBlock x:Name="Technical" Style="{StaticResource CaptionText}" FontFamily="Cascadia Mono, Consolas" Margin="0,8,0,0" />
                </StackPanel>
            </ui:CardExpander>

            <TextBlock Text="Windows" Style="{StaticResource SectionHeader}" />
            <ui:CardControl Margin="0,0,0,4">
                <ui:CardControl.Icon>
                    <ui:SymbolIcon Symbol="Chat24" />
                </ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="Non abbassare gli altri suoni durante le chiamate" Style="{StaticResource BodyText}" />
                        <TextBlock Text="Windows normalmente riduce dell'80% tutto il resto quando rileva una chiamata: rovinerebbe il mix." Style="{StaticResource CaptionText}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="NoDucking" Checked="Ducking_Changed" Unchecked="Ducking_Changed"
                                 AutomationProperties.Name="Non abbassare gli altri suoni durante le chiamate" />
            </ui:CardControl>

            <TextBlock Text="Risoluzione dei problemi" Style="{StaticResource SectionHeader}" />
            <ui:CardControl Margin="0,0,0,4">
                <ui:CardControl.Icon>
                    <ui:SymbolIcon Symbol="Wrench24" />
                </ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="Ripara l'audio di Windows" Style="{StaticResource BodyText}" />
                        <TextBlock Text="Riavvia il servizio audio: serve se la scheda audio smette di suonare in tutte le app. L'audio si interrompe per qualche secondo." Style="{StaticResource CaptionText}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:Button x:Name="RepairButton" Content="Ripara audio" Click="Repair_Click" MinWidth="120" />
            </ui:CardControl>
        </StackPanel>
</Page>
