<Page x:Class="DualMix.UI.Pages.AudioPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:core="clr-namespace:DualMix.Core"
      xmlns:local="clr-namespace:DualMix.UI"
      Title="{Binding [Audio.Title], Source={x:Static core:Loc.Instance}}"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <!-- Scrolling is provided by the navigation frame (WPF-UI DynamicScrollViewer). -->
        <StackPanel Margin="{StaticResource PagePadding}" MaxWidth="1000">
            <ui:TextBlock Text="{Binding [Audio.Title], Source={x:Static core:Loc.Instance}}" FontTypography="Title" />
            <TextBlock Style="{StaticResource CaptionText}" FontSize="14" Margin="0,4,0,20"
                       Text="{Binding [Audio.Subtitle], Source={x:Static core:Loc.Instance}}" />

            <local:StatusBanner ShowSuccess="True" />

            <TextBlock Text="{Binding [Audio.OutputSection], Source={x:Static core:Loc.Instance}}" Style="{StaticResource SectionHeader}" Margin="0,8,0,8" />
            <ui:CardControl Margin="0,0,0,4">
                <ui:CardControl.Icon>
                    <ui:SymbolIcon Symbol="Headphones24" />
                </ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="{Binding [Audio.RealOutput], Source={x:Static core:Loc.Instance}}" Style="{StaticResource BodyText}" />
                        <TextBlock Text="{Binding [Audio.RealOutputDesc], Source={x:Static core:Loc.Instance}}" Style="{StaticResource CaptionText}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ComboBox x:Name="OutputCombo" MinWidth="300" MaxWidth="380" DisplayMemberPath="Label" SelectionChanged="Output_Changed"
                          AutomationProperties.Name="Real playback device" />
            </ui:CardControl>

            <TextBlock Text="{Binding [Audio.VirtualSection], Source={x:Static core:Loc.Instance}}" Style="{StaticResource SectionHeader}" />
            <ui:CardControl Margin="0,0,0,4">
                <ui:CardControl.Icon>
                    <ui:SymbolIcon Symbol="SoundSource24" />
                </ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="{Binding [Audio.UseVirtual], Source={x:Static core:Loc.Instance}}" Style="{StaticResource BodyText}" />
                        <TextBlock Text="{Binding [Audio.UseVirtualDesc], Source={x:Static core:Loc.Instance}}" Style="{StaticResource CaptionText}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="UseVirtual" Checked="UseVirtual_Changed" Unchecked="UseVirtual_Changed"
                                 AutomationProperties.Name="Use virtual outputs" />
            </ui:CardControl>

            <ui:CardControl Margin="0,0,0,4">
                <ui:CardControl.Icon>
                    <ui:SymbolIcon Symbol="ArrowDownload24" />
                </ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="{Binding [Audio.DriverTitle], Source={x:Static core:Loc.Instance}}" Style="{StaticResource BodyText}" />
                        <TextBlock x:Name="DriverText" Style="{StaticResource CaptionText}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:Button x:Name="DriverButton" Content="{Binding [Audio.DriverBtn.Install], Source={x:Static core:Loc.Instance}}" Click="Driver_Click" MinWidth="120" />
            </ui:CardControl>
            <ui:InfoBar x:Name="SetupInfo" IsOpen="False" IsClosable="True" Margin="0,0,0,4" />

            <ui:CardControl x:Name="GameDirectCard" Margin="0,0,0,4">
                <ui:CardControl.Icon>
                    <ui:SymbolIcon Symbol="Games24" />
                </ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="{Binding [Audio.GameDirect], Source={x:Static core:Loc.Instance}}" Style="{StaticResource BodyText}" />
                        <TextBlock Text="{Binding [Audio.GameDirectDesc], Source={x:Static core:Loc.Instance}}" Style="{StaticResource CaptionText}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="GameDirect" Checked="Option_Changed" Unchecked="Option_Changed"
                                 AutomationProperties.Name="Play Game directly on sound card" />
            </ui:CardControl>

            <ui:CardControl Margin="0,0,0,4">
                <ui:CardControl.Icon>
                    <ui:SymbolIcon Symbol="Star24" />
                </ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="{Binding [Audio.SetDefaults], Source={x:Static core:Loc.Instance}}" Style="{StaticResource BodyText}" />
                        <TextBlock x:Name="DefaultsText" Style="{StaticResource CaptionText}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="SetDefaults" Checked="Option_Changed" Unchecked="Option_Changed"
                                 AutomationProperties.Name="Set Windows default devices" />
            </ui:CardControl>

            <ui:CardControl Margin="0,0,0,4">
                <ui:CardControl.Icon>
                    <ui:SymbolIcon Symbol="Apps24" />
                </ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="{Binding [Audio.RouteApps], Source={x:Static core:Loc.Instance}}" Style="{StaticResource BodyText}" />
                        <TextBlock Text="{Binding [Audio.RouteAppsDesc], Source={x:Static core:Loc.Instance}}" Style="{StaticResource CaptionText}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="RouteApps" Checked="Option_Changed" Unchecked="Option_Changed"
                                 AutomationProperties.Name="Auto-route apps" />
            </ui:CardControl>

            <TextBlock Text="{Binding [Audio.QualitySection], Source={x:Static core:Loc.Instance}}" Style="{StaticResource SectionHeader}" />
            <ui:CardControl Margin="0,0,0,4">
                <ui:CardControl.Icon>
                    <ui:SymbolIcon Symbol="Gauge24" />
                </ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="{Binding [Audio.Latency], Source={x:Static core:Loc.Instance}}" Style="{StaticResource BodyText}" />
                        <TextBlock Text="{Binding [Audio.LatencyDesc], Source={x:Static core:Loc.Instance}}" Style="{StaticResource CaptionText}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <Border Style="{StaticResource SegmentHost}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="LMin" Style="{StaticResource SegmentItem}" Content="{Binding [Audio.Latency.Min], Source={x:Static core:Loc.Instance}}" Tag="Minima" Checked="Latency_Checked" />
                        <RadioButton x:Name="LBal" Style="{StaticResource SegmentItem}" Content="{Binding [Audio.Latency.Bal], Source={x:Static core:Loc.Instance}}" Tag="Bilanciata" Checked="Latency_Checked" />
                        <RadioButton x:Name="LSafe" Style="{StaticResource SegmentItem}" Content="{Binding [Audio.Latency.Safe], Source={x:Static core:Loc.Instance}}" Tag="Sicura" Checked="Latency_Checked" />
                    </StackPanel>
                </Border>
            </ui:CardControl>

            <ui:CardExpander Margin="0,0,0,4" IsExpanded="True">
                <ui:CardExpander.Icon>
                    <ui:SymbolIcon Symbol="Options24" />
                </ui:CardExpander.Icon>
                <ui:CardExpander.Header>
                    <StackPanel>
                        <TextBlock Text="{Binding [Audio.SignalPath], Source={x:Static core:Loc.Instance}}" Style="{StaticResource BodyText}" />
                        <TextBlock x:Name="QualitySummary" Style="{StaticResource CaptionText}" />
                    </StackPanel>
                </ui:CardExpander.Header>
                <StackPanel Margin="44,0,0,0">
                    <TextBlock Style="{StaticResource BodyText}" FontSize="13" Margin="0,0,0,8"
                               Text="{Binding [Audio.Signal.Bullet1], Source={x:Static core:Loc.Instance}}" />
                    <TextBlock Style="{StaticResource BodyText}" FontSize="13" Margin="0,0,0,8"
                               Text="{Binding [Audio.Signal.Bullet2], Source={x:Static core:Loc.Instance}}" />
                    <TextBlock Style="{StaticResource BodyText}" FontSize="13" Margin="0,0,0,8"
                               Text="{Binding [Audio.Signal.Bullet3], Source={x:Static core:Loc.Instance}}" />
                    <TextBlock Style="{StaticResource BodyText}" FontSize="13" Margin="0,0,0,8"
                               Text="{Binding [Audio.Signal.Bullet4], Source={x:Static core:Loc.Instance}}" />
                    <TextBlock x:Name="Technical" Style="{StaticResource CaptionText}" FontFamily="Cascadia Mono, Consolas" Margin="0,8,0,0" />
                </StackPanel>
            </ui:CardExpander>

            <TextBlock Text="{Binding [Audio.WindowsSection], Source={x:Static core:Loc.Instance}}" Style="{StaticResource SectionHeader}" />
            <ui:CardControl Margin="0,0,0,4">
                <ui:CardControl.Icon>
                    <ui:SymbolIcon Symbol="Chat24" />
                </ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="{Binding [Audio.Ducking], Source={x:Static core:Loc.Instance}}" Style="{StaticResource BodyText}" />
                        <TextBlock Text="{Binding [Audio.DuckingDesc], Source={x:Static core:Loc.Instance}}" Style="{StaticResource CaptionText}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="NoDucking" Checked="Ducking_Changed" Unchecked="Ducking_Changed"
                                 AutomationProperties.Name="Do not lower other sounds during calls" />
            </ui:CardControl>

            <TextBlock Text="{Binding [Audio.TroubleshootSection], Source={x:Static core:Loc.Instance}}" Style="{StaticResource SectionHeader}" />
            <ui:CardControl Margin="0,0,0,4">
                <ui:CardControl.Icon>
                    <ui:SymbolIcon Symbol="Wrench24" />
                </ui:CardControl.Icon>
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="{Binding [Audio.RepairCard], Source={x:Static core:Loc.Instance}}" Style="{StaticResource BodyText}" />
                        <TextBlock Text="{Binding [Audio.RepairCardDesc], Source={x:Static core:Loc.Instance}}" Style="{StaticResource CaptionText}" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:Button x:Name="RepairButton" Content="{Binding [Banner.Repair], Source={x:Static core:Loc.Instance}}" Click="Repair_Click" MinWidth="120" />
            </ui:CardControl>
        </StackPanel>
</Page>
