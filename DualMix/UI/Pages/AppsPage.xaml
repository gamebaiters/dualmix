<Page x:Class="DualMix.UI.Pages.AppsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:core="clr-namespace:DualMix.Core"
      xmlns:local="clr-namespace:DualMix.UI"
      Title="{Binding [Apps.Title], Source={x:Static core:Loc.Instance}}"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <!-- Scrolling is provided by the navigation frame (WPF-UI DynamicScrollViewer). -->
        <StackPanel Margin="{StaticResource PagePadding}" MaxWidth="1000">
            <ui:TextBlock Text="{Binding [Apps.Title], Source={x:Static core:Loc.Instance}}" FontTypography="Title" />
            <TextBlock Style="{StaticResource CaptionText}" FontSize="14" Margin="0,4,0,20"
                       Text="{Binding [Apps.Subtitle], Source={x:Static core:Loc.Instance}}" />

            <!-- Toolbar -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBox x:Name="SearchBox" PlaceholderText="{Binding [Apps.SearchPlaceholder], Source={x:Static core:Loc.Instance}}" TextChanged="Search_TextChanged" ClearButtonEnabled="True"
                            AutomationProperties.Name="Search apps">
                    <ui:TextBox.Icon>
                        <ui:SymbolIcon Symbol="Search24" />
                    </ui:TextBox.Icon>
                </ui:TextBox>
                <ui:ToggleSwitch x:Name="ShowInactive" Grid.Column="2" Content="{Binding [Apps.ShowInactive], Source={x:Static core:Loc.Instance}}" Margin="16,0" VerticalAlignment="Center"
                                 Checked="ShowInactive_Changed" Unchecked="ShowInactive_Changed" />
                <ui:Button Grid.Column="3" Content="{Binding [Apps.AddApp], Source={x:Static core:Loc.Instance}}" Click="Add_Click" ToolTip="{Binding [Apps.AddAppTip], Source={x:Static core:Loc.Instance}}">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="Add24" />
                    </ui:Button.Icon>
                </ui:Button>
            </Grid>

            <!-- Column legend -->
            <Grid Margin="16,0,16,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="232" />
                    <ColumnDefinition Width="36" />
                    <ColumnDefinition Width="176" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding [Apps.ColApp], Source={x:Static core:Loc.Instance}}" Style="{StaticResource CaptionText}" />
                <TextBlock Grid.Column="1" Text="{Binding [Apps.ColChannel], Source={x:Static core:Loc.Instance}}" Style="{StaticResource CaptionText}" />
                <TextBlock Grid.Column="3" Text="{Binding [Apps.ColVolume], Source={x:Static core:Loc.Instance}}" Style="{StaticResource CaptionText}" />
            </Grid>

            <ItemsControl x:Name="List" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:AppRow}">
                        <Border Style="{StaticResource Surface}" Padding="16,10" Margin="0,0,0,4" Opacity="{Binding Opacity}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="232" />
                                    <ColumnDefinition Width="36" />
                                    <ColumnDefinition Width="176" />
                                </Grid.ColumnDefinitions>

                                <!-- icon (or initial) -->
                                <Grid Width="32" Height="32" VerticalAlignment="Center">
                                    <Border CornerRadius="6" Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                            Visibility="{Binding HasIcon, Converter={StaticResource InverseBoolToVis}}">
                                        <TextBlock Text="{Binding Initial}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </Border>
                                    <Image Source="{Binding Icon}" Width="28" Height="28" RenderOptions.BitmapScalingMode="HighQuality"
                                           Visibility="{Binding HasIcon, Converter={StaticResource BoolToVis}}" />
                                </Grid>

                                <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DisplayName}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" ToolTip="{Binding Key}" />
                                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource CaptionText}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                               ToolTip="{Binding Hint}" />
                                    <Border Style="{StaticResource MeterTrack}" Height="3" Margin="0,6,0,0" MaxWidth="220" HorizontalAlignment="Stretch">
                                        <Border Background="{DynamicResource AccentFillColorDefaultBrush}" HorizontalAlignment="Stretch" RenderTransformOrigin="0,0.5">
                                            <Border.RenderTransform>
                                                <ScaleTransform ScaleX="{Binding Peak}" />
                                            </Border.RenderTransform>
                                        </Border>
                                    </Border>
                                </StackPanel>

                                <!-- Segmented channel picker -->
                                <Border Grid.Column="2" Style="{StaticResource SegmentHost}" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Style="{StaticResource SegmentItem}" Content="Game" IsChecked="{Binding IsGame, Mode=TwoWay}"
                                                     ToolTip="{Binding [Apps.GameTip], Source={x:Static core:Loc.Instance}}" AutomationProperties.Name="Game" />
                                        <RadioButton Style="{StaticResource SegmentItem}" Content="Chat" IsChecked="{Binding IsChat, Mode=TwoWay}"
                                                     ToolTip="{Binding [Apps.ChatTip], Source={x:Static core:Loc.Instance}}" AutomationProperties.Name="Chat" />
                                        <RadioButton Style="{StaticResource SegmentItem}" Content="{Binding [Common.Direct], Source={x:Static core:Loc.Instance}}" IsChecked="{Binding IsDirect, Mode=TwoWay}"
                                                     ToolTip="{Binding [Apps.DirectTip], Source={x:Static core:Loc.Instance}}" AutomationProperties.Name="Direct" />
                                    </StackPanel>
                                </Border>

                                <ui:Button Grid.Column="3" Appearance="Transparent" Padding="6" Width="32" Height="32" VerticalAlignment="Center"
                                           ToolTip="{Binding [Apps.AutoResetTip], Source={x:Static core:Loc.Instance}}" Click="Auto_Click" Tag="{Binding}"
                                           Visibility="{Binding IsExplicit, Converter={StaticResource BoolToVis}}">
                                    <ui:SymbolIcon Symbol="ArrowReset24" FontSize="16" />
                                </ui:Button>

                                <Grid Grid.Column="4" VerticalAlignment="Center" Margin="8,0,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="40" />
                                    </Grid.ColumnDefinitions>
                                    <Slider Minimum="0" Maximum="100" SmallChange="1" LargeChange="10" IsMoveToPointEnabled="True"
                                            Value="{Binding VolumePercent, Mode=TwoWay, Delay=60}" AutomationProperties.Name="Volume dell'app" />
                                    <TextBlock Grid.Column="1" Text="{Binding VolumePercent, StringFormat={}{0:0}%}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                               FontSize="13" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Empty state -->
            <Border x:Name="EmptyState" Style="{StaticResource Surface}" Padding="24,32" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center">
                    <ui:SymbolIcon Symbol="SoundWaveCircle24" FontSize="40" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <TextBlock Text="{Binding [Apps.EmptyTitle], Source={x:Static core:Loc.Instance}}" HorizontalAlignment="Center" FontSize="16" FontWeight="SemiBold" Margin="0,12,0,4"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock Text="{Binding [Apps.EmptyBody], Source={x:Static core:Loc.Instance}}"
                               Style="{StaticResource CaptionText}" FontSize="13" TextAlignment="Center" MaxWidth="420" />
                </StackPanel>
            </Border>
        </StackPanel>
</Page>
