<ui:FluentWindow x:Class="DualMix.UI.SetupWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:core="clr-namespace:DualMix.Core"
                 Title="{Binding [Wizard.WindowTitle], Source={x:Static core:Loc.Instance}}"
                 Width="680" Height="590" ResizeMode="CanMinimize"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 Icon="pack://application:,,,/Assets/dualmix.ico">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="TitleBar" Grid.Row="0" Title="{Binding [Wizard.WindowTitle], Source={x:Static core:Loc.Instance}}"
                     ShowMaximize="False" ShowMinimize="False">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/dualmix.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- Content area -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="32,8,32,16">
            <Grid>
                <!-- STEP 1: Welcome & Language -->
                <StackPanel x:Name="Step1Panel">
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,16">
                        <Image Source="pack://application:,,,/Assets/dualmix.ico" Width="48" Height="48" VerticalAlignment="Center" />
                        <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding [Wizard.S1.Title], Source={x:Static core:Loc.Instance}}" FontSize="24" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="{Binding [Wizard.S1.Subtitle], Source={x:Static core:Loc.Instance}}" Style="{StaticResource CaptionText}"
                                       FontSize="13" MaxWidth="540" Margin="0,4,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <Grid Margin="0,4,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource Surface}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Border Style="{StaticResource IconBadge}" Width="32" Height="32" CornerRadius="16" Background="{DynamicResource GameSoftBrush}">
                                        <ui:SymbolIcon Symbol="Games24" FontSize="16" Foreground="{DynamicResource GameBrush}" />
                                    </Border>
                                    <TextBlock Text="{Binding [Wizard.S1.GameTitle], Source={x:Static core:Loc.Instance}}" FontSize="15" FontWeight="SemiBold"
                                               VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                </StackPanel>
                                <TextBlock Text="{Binding [Wizard.S1.GameDesc], Source={x:Static core:Loc.Instance}}" Style="{StaticResource CaptionText}" FontSize="13" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource Surface}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Border Style="{StaticResource IconBadge}" Width="32" Height="32" CornerRadius="16" Background="{DynamicResource ChatSoftBrush}">
                                        <ui:SymbolIcon Symbol="Chat24" FontSize="16" Foreground="{DynamicResource ChatBrush}" />
                                    </Border>
                                    <TextBlock Text="{Binding [Wizard.S1.ChatTitle], Source={x:Static core:Loc.Instance}}" FontSize="15" FontWeight="SemiBold"
                                               VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                </StackPanel>
                                <TextBlock Text="{Binding [Wizard.S1.ChatDesc], Source={x:Static core:Loc.Instance}}" Style="{StaticResource CaptionText}" FontSize="13" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Style="{StaticResource Surface}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="{Binding [Wizard.S1.LangLabel], Source={x:Static core:Loc.Instance}}" Style="{StaticResource BodyText}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding [Wizard.S1.LangHint], Source={x:Static core:Loc.Instance}}" Style="{StaticResource CaptionText}" Margin="0,2,0,0" />
                            </StackPanel>
                            <Border Grid.Column="1" Style="{StaticResource SegmentHost}" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="LangAuto" Style="{StaticResource SegmentItem}" Content="{Binding [General.Language.Auto], Source={x:Static core:Loc.Instance}}" Tag="Auto" Checked="Language_Checked" />
                                    <RadioButton x:Name="LangEn" Style="{StaticResource SegmentItem}" Content="English" Tag="English" Checked="Language_Checked" />
                                    <RadioButton x:Name="LangIt" Style="{StaticResource SegmentItem}" Content="Italiano" Tag="Italian" Checked="Language_Checked" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- STEP 2: Output Device & Mode -->
                <StackPanel x:Name="Step2Panel" Visibility="Collapsed">
                    <TextBlock Text="{Binding [Wizard.S2.Title], Source={x:Static core:Loc.Instance}}" FontSize="22" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,4,0,4" />
                    <TextBlock Text="{Binding [Wizard.S2.Subtitle], Source={x:Static core:Loc.Instance}}" Style="{StaticResource CaptionText}" FontSize="13" Margin="0,0,0,16" />

                    <Border Style="{StaticResource Surface}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="{Binding [Wizard.S2.OutputLabel], Source={x:Static core:Loc.Instance}}" Style="{StaticResource BodyText}" FontWeight="SemiBold" />
                            <ComboBox x:Name="OutputCombo" DisplayMemberPath="Label" Margin="0,8,0,6" HorizontalAlignment="Stretch" />
                            <TextBlock Text="{Binding [Wizard.S2.OutputHint], Source={x:Static core:Loc.Instance}}" Style="{StaticResource CaptionText}" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{Binding [Wizard.S2.ModeLabel], Source={x:Static core:Loc.Instance}}" Style="{StaticResource SectionHeader}" Margin="0,4,0,8" />

                    <Border Style="{StaticResource Surface}" Margin="0,0,0,8">
                        <RadioButton x:Name="ModePerApp" GroupName="WizMode" Checked="Mode_Changed">
                            <StackPanel Margin="6,0,0,0">
                                <TextBlock Text="{Binding [Wizard.S2.ModePerAppTitle], Source={x:Static core:Loc.Instance}}" Style="{StaticResource BodyText}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding [Wizard.S2.ModePerAppDesc], Source={x:Static core:Loc.Instance}}" Style="{StaticResource CaptionText}" Margin="0,2,0,0" />
                            </StackPanel>
                        </RadioButton>
                    </Border>

                    <Border Style="{StaticResource Surface}">
                        <RadioButton x:Name="ModeVirtual" GroupName="WizMode" Checked="Mode_Changed">
                            <StackPanel Margin="6,0,0,0">
                                <TextBlock Text="{Binding [Wizard.S2.ModeVirtualTitle], Source={x:Static core:Loc.Instance}}" Style="{StaticResource BodyText}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding [Wizard.S2.ModeVirtualDesc], Source={x:Static core:Loc.Instance}}" Style="{StaticResource CaptionText}" Margin="0,2,0,0" />
                                <TextBlock x:Name="VbStatusText" Style="{StaticResource CaptionText}" FontWeight="SemiBold" Margin="0,6,0,0"
                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            </StackPanel>
                        </RadioButton>
                    </Border>
                </StackPanel>

                <!-- STEP 3: Controls & Startup -->
                <StackPanel x:Name="Step3Panel" Visibility="Collapsed">
                    <TextBlock Text="{Binding [Wizard.S3.Title], Source={x:Static core:Loc.Instance}}" FontSize="22" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,4,0,4" />
                    <TextBlock Text="{Binding [Wizard.S3.Subtitle], Source={x:Static core:Loc.Instance}}" Style="{StaticResource CaptionText}" FontSize="13" Margin="0,0,0,16" />

                    <Border Style="{StaticResource Surface}" Margin="0,0,0,12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <ui:SymbolIcon Symbol="Keyboard24" FontSize="18" Margin="0,0,10,0" />
                                <TextBlock Text="{Binding [Wizard.S3.KnobBoxTitle], Source={x:Static core:Loc.Instance}}" Style="{StaticResource BodyText}" FontWeight="SemiBold" />
                            </StackPanel>
                            <TextBlock Text="{Binding [Wizard.S3.KnobRule1], Source={x:Static core:Loc.Instance}}" Style="{StaticResource CaptionText}" FontSize="13" Margin="0,0,0,4" />
                            <TextBlock Text="{Binding [Wizard.S3.KnobRule2], Source={x:Static core:Loc.Instance}}" Style="{StaticResource CaptionText}" FontSize="13" Margin="0,0,0,4" />
                            <TextBlock Text="{Binding [Wizard.S3.KnobRule3], Source={x:Static core:Loc.Instance}}" Style="{StaticResource CaptionText}" FontSize="13" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Surface}" Margin="0,0,0,10">
                        <StackPanel>
                            <CheckBox x:Name="StartWithWindowsCheck" IsChecked="True" Margin="0,0,0,8">
                                <TextBlock Text="{Binding [Wizard.S3.StartWithWindows], Source={x:Static core:Loc.Instance}}" Style="{StaticResource BodyText}" FontSize="13" />
                            </CheckBox>
                            <CheckBox x:Name="DisableDuckingCheck" IsChecked="True">
                                <TextBlock Text="{Binding [Wizard.S3.DisableDucking], Source={x:Static core:Loc.Instance}}" Style="{StaticResource BodyText}" FontSize="13" />
                            </CheckBox>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{Binding [Wizard.S3.DoneNote], Source={x:Static core:Loc.Instance}}" Style="{StaticResource CaptionText}" Margin="2,4,2,0" />
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Padding="24,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StepLabel" VerticalAlignment="Center" Style="{StaticResource CaptionText}" FontSize="13" />
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <ui:Button x:Name="BackButton" Content="{Binding [Wizard.Back], Source={x:Static core:Loc.Instance}}" Click="Back_Click" Margin="0,0,8,0" MinWidth="96" />
                    <ui:Button x:Name="NextButton" Content="{Binding [Wizard.Next], Source={x:Static core:Loc.Instance}}" Appearance="Primary" Click="Next_Click" MinWidth="128" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
